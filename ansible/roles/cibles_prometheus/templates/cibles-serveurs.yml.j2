# Généré par Ansible depuis l'inventaire du client {{ client }}.
# Ne pas modifier à la main : modifier l'inventaire et relancer Ansible.
{% for serveur in cibles_prometheus_serveurs %}
- targets: ["{{ hostvars[serveur].ansible_host | default(serveur) }}:{{ cibles_prometheus_port }}"]
  labels:
    client: {{ client }}
    serveur: {{ serveur }}
{% endfor %}
